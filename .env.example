# Copier via npm run init pour générer une vraie clé de chiffrement.
ENCRYPTION_KEY=GENERER_AVEC_NPM_RUN_INIT
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/service.sqlite
# false uniquement pour tester en HTTP local. true derrière HTTPS en production.
SECURE_COOKIES=false
# Ne faire confiance qu’au proxy local explicitement configuré.
TRUST_PROXY=127.0.0.1,::1
RETENTION_DAYS=7
STATISTICS_DAYS=365
ASYNC_WAIT_SECONDS=86400
CHAT_WAIT_SECONDS=600
ATTEMPT_TIMEOUT_SECONDS=1800
PROBE_INTERVAL_SECONDS=15
MAX_QUEUED=2000
MAX_QUEUED_PER_APP=500
