[Unit]
Description=La Providence - Ordonnanceur IA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=providence-ai
Group=providence-ai
WorkingDirectory=/opt/providence-ai/current
EnvironmentFile=/etc/providence-ai/service.env
EnvironmentFile=-/etc/providence-ai/release.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/providence-ai/current/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/providence-ai
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
