[Unit]
Description=Sauvegarde SQLite de l’ordonnanceur IA

[Service]
Type=oneshot
User=providence-ai
Group=providence-ai
WorkingDirectory=/opt/providence-ai/current
EnvironmentFile=/etc/providence-ai/service.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/providence-ai/current/scripts/backup.js
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/providence-ai
