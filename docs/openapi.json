    "/v1/models": {
      "get": {
        "tags": [
          "Catalogue"
        ],
        "summary": "Modèles autorisés",
        "responses": {
          "200": {
            "description": "Catalogue filtré",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
