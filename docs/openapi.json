    "/v1/chat/completions": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat synchrone ou streaming OpenAI avec mise en file",
        "description": "X-Job-ID est envoyé immédiatement en streaming. Commentaires SSE pendant l’attente ; fragments Chat Completions puis [DONE]. Les erreurs après ouverture du flux sont des événements data contenant error. Une déconnexion annule le job. Pas de reprise après exposition du premier fragment.",
        "parameters": [
          {
            "name": "X-End-User-ID",
            "in": "header",
            "description": "Identifiant opaque propre à l’application ; obligatoire si sa politique le demande.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réponse OpenAI ou flux SSE",
            "headers": {
              "X-Job-ID": {
                "description": "Job à consulter via GET /v1/jobs/{id}",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Erreur explicite du service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Erreur explicite du service",
            "content": {
