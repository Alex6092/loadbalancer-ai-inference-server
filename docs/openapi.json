{
  "openapi": "3.1.0",
  "info": {
    "title": "La Providence — Ordonnanceur IA",
    "version": "1.0.0",
    "description": "Authentification serveur à serveur. Les callbacks sont signés HMAC-SHA256(timestamp + \".\" + corps brut). Voir docs/API.md pour les règles de livraison et d’administration."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Développement local"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "additionalProperties": true,
        "properties": {
          "model": {
            "type": "string",
            "description": "Identifiant exact déclaré dans le catalogue et servi par le worker."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "role"
              ],
              "additionalProperties": true,
              "properties": {
                "role": {
                  "enum": [
                    "system",
                    "developer",
                    "user",
                    "assistant",
                    "tool",
                    "function"
                  ]
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "text"
                            ],
                            "properties": {
                              "type": {
                                "const": "text"
                              },
                              "text": {
                                "type": "string"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "image_url"
                            ],
                            "properties": {
                              "type": {
                                "const": "image_url"
                              },
                              "image_url": {
                                "type": "object",
                                "required": [
                                  "url"
                                ],
                                "properties": {
                                  "url": {
                                    "type": "string"
                                  },
                                  "detail": {
                                    "enum": [
                                      "auto",
                                      "low",
                                      "high"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Exclusif avec max_completion_tokens ; sortie par défaut définie par le modèle."
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "n": {
            "const": 1
          },
          "stream": {
            "type": "boolean",
            "default": false
          },
          "temperature": {
            "type": "number"
          },
          "top_p": {
            "type": "number"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "tool_choice": {},
          "response_format": {
            "type": "object"
          },
          "stream_options": {
            "type": "object"
          }
        }
      },
      "AsyncRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "additionalProperties": true,
        "properties": {
          "model": {
            "type": "string",
            "description": "Identifiant exact déclaré dans le catalogue et servi par le worker."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "role"
              ],
              "additionalProperties": true,
              "properties": {
                "role": {
                  "enum": [
                    "system",
                    "developer",
                    "user",
                    "assistant",
                    "tool",
                    "function"
                  ]
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "text"
                            ],
                            "properties": {
                              "type": {
                                "const": "text"
                              },
                              "text": {
                                "type": "string"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "image_url"
                            ],
                            "properties": {
                              "type": {
                                "const": "image_url"
                              },
                              "image_url": {
                                "type": "object",
                                "required": [
                                  "url"
                                ],
                                "properties": {
                                  "url": {
                                    "type": "string"
                                  },
                                  "detail": {
                                    "enum": [
                                      "auto",
                                      "low",
                                      "high"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Exclusif avec max_completion_tokens ; sortie par défaut définie par le modèle."
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "n": {
            "const": 1
          },
          "stream": {
            "const": false
          },
          "temperature": {
            "type": "number"
          },
          "top_p": {
            "type": "number"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "tool_choice": {},
          "response_format": {
            "type": "object"
          },
          "stream_options": {
            "type": "object"
          },
          "callbackURL": {
            "type": "string",
            "format": "uri",
            "description": "Destination appartenant aux URL de base autorisées de l’application. Facultative."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "Usage": {
        "type": "object",
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens",
          "estimated"
        ],
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "completion_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "estimated": {
            "type": "boolean"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status",
          "mode",
          "model",
          "usage",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "job"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "expired"
            ]
          },
          "mode": {
            "enum": [
              "chat",
              "async"
            ]
          },
          "model": {
            "type": "string"
          },
          "attempts": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "queue": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "estimated_jobs_ahead",
                  "running_for_model",
                  "reason",
                  "calculated_at",
                  "estimate"
                ],
                "properties": {
                  "estimated_jobs_ahead": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "running_for_model": {
                    "type": "integer"
                  },
                  "reason": {
                    "enum": [
                      "capacity",
                      "workers_unavailable",
                      "retry_backoff"
                    ]
                  },
                  "calculated_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "estimate": {
                    "const": true
                  }
                }
              }
            ]
          },
          "result": {},
          "error": {},
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "content_expired": {
            "type": "boolean"
          },
          "reused": {
            "type": "boolean"
          },
          "links": {
            "type": "object",
            "required": [
              "self",
              "cancel"
            ],
            "properties": {
              "self": {
                "type": "string"
              },
              "cancel": {
                "type": "string"
              }
            }
          }
        }
      },
      "Model": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "model"
          },
          "owned_by": {
            "type": "string"
          },
          "vision": {
            "type": "boolean"
          },
          "context_tokens": {
            "type": "integer"
          },
          "max_output_tokens": {
            "type": "integer"
          }
        }
      },
      "Policy": {
        "type": "object",
        "properties": {
          "count": {
            "enum": [
              "input",
              "output",
              "both"
            ],
            "default": "both"
          },
          "credit": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "windows": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "hours",
                "tokens"
              ],
              "properties": {
                "hours": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 87600
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        }
      },
      "CallbackEvent": {
        "type": "object",
        "required": [
          "id",
          "type",
          "created_at",
          "job_id",
          "status",
          "result",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant stable à dédupliquer transactionnellement."
          },
          "type": {
            "enum": [
              "job.succeeded",
              "job.failed",
              "job.cancelled",
              "job.expired"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "job_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "expired"
            ]
          },
          "result": {},
          "error": {}
        }
      }
    }
  },
  "paths": {
    "/v1/jobs": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Soumettre un traitement asynchrone",
        "parameters": [
          {
            "name": "X-End-User-ID",
            "in": "header",
            "description": "Identifiant opaque propre à l’application ; obligatoire si sa politique le demande.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Réutiliser la même valeur et le même payload en cas de doute sur la réception. Périmètre : clé d’API.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AsyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Soumission déjà enregistrée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "202": {
            "description": "Accepté durablement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Erreur explicite du service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Erreur explicite du service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Erreur explicite du service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Erreur explicite du service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Erreur explicite du service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Erreur explicite du service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Erreur explicite du service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
